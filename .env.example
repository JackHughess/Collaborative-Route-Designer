# Copy to .env.local and fill in. Never commit real values.
# Supabase values: Dashboard → Project Settings → API Keys.

# ── Public (exposed to the browser; protected by RLS) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Secret (server only: Next.js server code + Hocuspocus) ─────────
# Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Only for projects still on the legacy JWT secret. Projects using
# signing keys verify tokens via JWKS and don't need this.
# SUPABASE_JWT_SECRET=

# Email provider for invite emails (e.g. Resend)
RESEND_API_KEY=

# ── Collaboration server (Hocuspocus) ──────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
PORT=1234
# Only when running multiple Hocuspocus instances
# REDIS_URL=

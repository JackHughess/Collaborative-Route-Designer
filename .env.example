# Copy to .env.local and fill in. Never commit real values.
# Supabase values: Dashboard → Project Settings → API Keys.

# ── Public (exposed to the browser; protected by RLS) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Secret (server only: Next.js server code + Hocuspocus) ─────────
# Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Only for projects still on the legacy JWT secret. Projects using
# signing keys verify tokens via JWKS and don't need this.
# SUPABASE_JWT_SECRET=

# ── Collaboration server (Hocuspocus) ──────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
PORT=1234
# Only when running multiple Hocuspocus instances
# REDIS_URL=

# ── End-to-end tests (Playwright) ──────────────────────────────────
# Two throwaway accounts in the Supabase project the tests run against,
# with confirmed emails and the same password. Never use real accounts.
E2E_OWNER_EMAIL=e2e-owner@example.com
E2E_COLLAB_EMAIL=e2e-collab@example.com
E2E_PASSWORD=
